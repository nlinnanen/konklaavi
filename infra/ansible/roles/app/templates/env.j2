# Managed by Ansible (infra/ansible/roles/app), except IMAGE_TAG, which junction26-release sets.
COMPOSE_PROJECT_NAME={{ compose_project_name }}
COMPOSE_FILE=compose.yaml:deploy/compose.prod.yaml
DOMAIN={{ app_domain }}
ALT_DOMAINS={{ app_alt_domains }}
POSTGRES_PASSWORD={{ postgres_password }}
IMAGE_PREFIX={{ image_prefix }}
IMAGE_TAG={{ app_current_image_tag }}
API_PORT=8000
DASH_PORT=8501
# Empty values fall back to compose.yaml's and backend/app/config.py's defaults.
HOSTINGER_ROUTER_KEY={{ hostinger_router_key }}
ANTHROPIC_BASE_URL={{ anthropic_base_url }}
MODERATION_MODEL={{ moderation_model }}
MODERATOR_EMAILS={{ moderator_emails }}
MODERATOR_REPUTATION={{ moderator_reputation }}
NOTE_MIN_RATINGS={{ note_min_ratings }}
BRIDGING_MIN_HISTORY={{ bridging_min_history }}
AGREEMENT_HELPFUL={{ agreement_helpful }}
AGREEMENT_NOT_HELPFUL={{ agreement_not_helpful }}
NARRATIVE_MATCH_THRESHOLD={{ narrative_match_threshold }}
OWN_HOSTS={{ own_hosts }}
