# DOMAIN, and any further hostnames in ALT_DOMAINS (space-separated), serve the same app.
{$DOMAIN} {$ALT_DOMAINS} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	# The moderators' admin panel, which the API serves at /admin.
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy api:8000
	}

	# The web demo moved from /demo/ to the root; old links keep working.
	redir /demo /
	handle_path /demo/* {
		redir * {uri} 308
	}

	# Everything else is the web demo (demo/proxy-view).
	handle {
		reverse_proxy proxy-view:8787
	}
}
