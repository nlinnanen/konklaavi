# DOMAIN, and any further hostnames in ALT_DOMAINS (space-separated), serve the same app.
{$DOMAIN} {$ALT_DOMAINS} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	redir /demo /demo/
	handle_path /demo/* {
		reverse_proxy proxy-view:8787
	}

	handle {
		reverse_proxy dashboard:8501
	}
}
